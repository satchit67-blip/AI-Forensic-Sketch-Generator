# ╔══════════════════════════════════════════════════════════════════════╗
# ║  AI NEXUS – Forensic Sketch Synthesizer · Environment Variables     ║
# ║                                                                      ║
# ║  HOW TO USE                                                          ║
# ║  1. Copy this file:  cp .env.example .env                           ║
# ║  2. Fill in every value marked  ← REQUIRED                          ║
# ║  3. NEVER commit the real .env to git (it is in .gitignore)         ║
# ╚══════════════════════════════════════════════════════════════════════╝


# ══════════════════════════════════════════════════════════════════════════
# SUPABASE POSTGRESQL
# ══════════════════════════════════════════════════════════════════════════
# Where to find this:
#   Supabase Dashboard → Project Settings → Database
#   → "Connection string" tab → URI (copy the "Transaction" pooler URL)
#
# The connection string must use the asyncpg driver.
# config.py auto-upgrades postgresql:// → postgresql+asyncpg:// for you.
#
# Format:
#   postgresql+asyncpg://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
#
# ← REQUIRED
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Set to true to echo all SQL statements to the console (dev only)
DB_ECHO=false


# ══════════════════════════════════════════════════════════════════════════
# JWT AUTHENTICATION
# ══════════════════════════════════════════════════════════════════════════
# Generate a strong random secret:
#   PowerShell : -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
#   bash/WSL   : openssl rand -hex 32
#
# ← REQUIRED
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# JWT signing algorithm — keep HS256 unless you have a specific reason to change it
ALGORITHM=HS256

# How long tokens stay valid (minutes). 60 = 1 hour.
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ══════════════════════════════════════════════════════════════════════════
# GOOGLE GEMINI API  (natural language → facial traits · prompt engineering)
# ══════════════════════════════════════════════════════════════════════════
# Get a FREE key at: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1 million tokens/day — plenty for a hackathon.
#
# ← REQUIRED
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_KEY_HERE


# ══════════════════════════════════════════════════════════════════════════
# IMAGE GENERATION  (FLUX.1-schnell / Stable Diffusion inpainting)
# ══════════════════════════════════════════════════════════════════════════
#
# IMAGE_MODE options:
#   "hf_api"   → Hugging Face Inference API  ← RECOMMENDED for hackathon
#                No GPU needed. ~1 000 free calls/day with a free HF account.
#
#   "local"    → Local diffusers pipeline
#                Requires a CUDA GPU with 6-8 GB VRAM.
#                Models are auto-downloaded on first use (~24 GB total).
#
#   "disabled" → No image generation.
#                The frontend uses the procedural SVG sketch only.
#                Use this if you have no HF token and no GPU.
#
IMAGE_MODE=hf_api

# Hugging Face token (read-only is enough for Inference API)
# Get a FREE token at: https://huggingface.co/settings/tokens
#
# ← REQUIRED if IMAGE_MODE=hf_api
HF_TOKEN=hf_YOUR_HF_TOKEN_HERE

# Model used for initial sketch generation (text → image)
# Default: FLUX.1-schnell  (4 inference steps, fast, high quality)
HF_GENERATE_MODEL=black-forest-labs/FLUX.1-schnell

# Model used for disguise inpainting (image + mask → refined image)
# Default: SD2-inpainting  (mask-guided, preserves unmasked regions)
HF_INPAINT_MODEL=stabilityai/stable-diffusion-2-inpainting

# Output resolution (keep multiples of 64 for Stable Diffusion)
IMAGE_WIDTH=512
IMAGE_HEIGHT=640

# Where generated images are saved on disk (relative to backend/ folder)
# Leave as-is for local dev; point to a volume mount in Docker/cloud.
IMAGE_STORE_PATH=./generated_images


# ══════════════════════════════════════════════════════════════════════════
# APPLICATION
# ══════════════════════════════════════════════════════════════════════════
APP_NAME=AI NEXUS – Forensic Sketch Synthesizer
APP_VERSION=1.0.0

# Set true in development: enables SQL echo, auto table-create on startup,
# and exposes /docs with full OpenAPI UI.
# Set FALSE before any public/demo deployment.
DEBUG=true


# ══════════════════════════════════════════════════════════════════════════
# CORS  (Cross-Origin Resource Sharing)
# ══════════════════════════════════════════════════════════════════════════
# Comma-separated list of allowed frontend origins.
# Always include the Vite dev server (default port 5173).
# Add your deployed frontend URL when going live.
#
# Examples:
#   Local only  : http://localhost:5173
#   Local + prod: http://localhost:5173,https://nexus.yourdomain.com
#
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
